{
  "name": "@carbonzhao/dsh-desktop-notify",
  "version": "0.3.0",
  "description": "DSH 桌面通知：所有 DSH 前端失焦时，对决策/授权/意外中断/任务完成发 Windows 通知（标题=会话标题，点击复用已有页面切回对话）",
  "type": "module",
  "main": "./lib/index.js",
  "author": "CarbonZhao",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarbonZhao-02692/dsh-desktop-notify.git"
  },
  "homepage": "https://github.com/CarbonZhao-02692/dsh-desktop-notify#readme",
  "bugs": {
    "url": "https://github.com/CarbonZhao-02692/dsh-desktop-notify/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "windows",
    "toast",
    "desktop-notification"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "assets",
    "docs",
    "cordis.patch.yml",
    "NOTICE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
